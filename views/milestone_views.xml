<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="solar_milestone_template_view_form" model="ir.ui.view">
        <field name="name">solar.milestone.template.form</field>
        <field name="model">solar.milestone.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="total_percent"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="percent"/>
                            <field name="trigger_code"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="solar_milestone_template_view_tree" model="ir.ui.view">
        <field name="name">solar.milestone.template.tree</field>
        <field name="model">solar.milestone.template</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="total_percent"/></tree></field>
    </record>
    <record id="solar_milestone_template_action" model="ir.actions.act_window">
        <field name="name">Milestone Templates</field>
        <field name="res_model">solar.milestone.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="solar_milestone_view_tree" model="ir.ui.view">
        <field name="name">solar.milestone.tree</field>
        <field name="model">solar.milestone</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'invoiced'" create="false">
                <field name="order_id"/>
                <field name="project_id"/>
                <field name="name"/>
                <field name="percent"/>
                <field name="amount"/>
                <field name="trigger_code"/>
                <field name="state"/>
                <field name="invoice_id"/>
                <button name="action_invoice" type="object" string="Invoice Now" icon="fa-file-text-o" invisible="state != 'pending'" groups="solar_security.group_solar_finance"/>
            </tree>
        </field>
    </record>
    <record id="solar_milestone_view_form" model="ir.ui.view">
        <field name="name">solar.milestone.form</field>
        <field name="model">solar.milestone</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_invoice" type="object" string="Create Invoice" class="btn-primary" invisible="state != 'pending'" groups="solar_security.group_solar_finance"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="order_id"/><field name="name"/><field name="percent"/>
                        <field name="amount"/><field name="trigger_code"/><field name="invoice_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter"><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="solar_milestone_action" model="ir.actions.act_window">
        <field name="name">Billing Milestones</field>
        <field name="res_model">solar.milestone</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
    <record id="solar_milestone_view_search" model="ir.ui.view">
        <field name="name">solar.milestone.search</field>
        <field name="model">solar.milestone</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
            </search>
        </field>
    </record>

    <!-- tree-only editable list of stages with their billing trigger -->
    <record id="project_stage_solar_tree" model="ir.ui.view">
        <field name="name">project.project.stage.solar.tree</field>
        <field name="model">project.project.stage</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="solar_milestone_code"/>
            </tree>
        </field>
    </record>
    <record id="project_stage_solar_action" model="ir.actions.act_window">
        <field name="name">Project Stages (Billing Triggers)</field>
        <field name="res_model">project.project.stage</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="project_stage_solar_tree"/>
    </record>
</odoo>